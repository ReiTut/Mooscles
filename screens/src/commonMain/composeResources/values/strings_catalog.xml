    <!-- The one-line caption under an exercise whose load is not the total load. -->
    <string name="catalog_convention_caption_per_hand">Per hand: log one dumbbell's load.</string>
    <string name="catalog_convention_caption_one_side">One side: log the load used on one side.</string>
    <string name="catalog_convention_caption_added_weight">Added weight: leave 0 for bodyweight only.</string>
    <string name="catalog_convention_caption_assistance">Assistance: log the machine's assistance.</string>

    <!-- The full explanation of each convention. -->
    <string name="catalog_convention_explanation_total_load">Log the total external load; volume = logged load × reps.</string>
    <string name="catalog_convention_explanation_per_hand">Log one dumbbell's load and reps. Volume is per hand; it is never doubled.</string>
    <string name="catalog_convention_explanation_one_side">Log the total external load used on one side and the reps for that side. Volume is per side; it is never doubled.</string>
    <string name="catalog_convention_explanation_added_weight">Leave the load at 0 for bodyweight, or log the added external weight. Bodyweight is not counted in weight moved.</string>
    <string name="catalog_convention_explanation_assistance">Log the assistance separately. Assistance earns no external-weight record and is not counted in weight moved.</string>

    <!-- The language of the catalog texts (exercise names, cues): "pt-BR" turns them Portuguese. -->
    <string name="catalog_names_language">en</string>

    <!-- The default routine folder while its stored name is still RoutineFolder.DEFAULT_NAME. -->
    <string name="catalog_default_folder">My routines</string>
</resources>
