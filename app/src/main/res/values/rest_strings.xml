<?xml version="1.0" encoding="utf-8"?>
<!-- The rest notifications (D16). Android resources, not the design system's: they are built outside Compose. -->
<resources>
    <string name="rest_channel_name">Rest timer</string>
    <string name="rest_channel_description">Alerts when an exercise rest period ends</string>
    <string name="rest_progress_channel_name">Rest in progress</string>
    <string name="rest_progress_channel_description">Counts down your rest while Mooscles is in the background</string>
    <string name="rest_progress_title">Rest</string>
    <!-- %1$s: exercise name; %2$d: number of the next pending set of that exercise. -->
    <string name="rest_progress_text">%1$s · next set %2$d</string>
    <!-- %1$s: the remaining time while the rest is paused, such as 1:08. -->
    <string name="rest_progress_paused">%1$s · paused</string>
    <string name="rest_action_minus" translatable="false">−15 s</string>
    <string name="rest_action_plus" translatable="false">+15 s</string>
    <string name="rest_action_skip">Skip</string>
    <string name="rest_finished_title">Rest is over</string>
    <!-- %1$s: exercise name; %2$d: number of the next pending set of that exercise. -->
    <string name="rest_finished_text">Next: %1$s, set %2$d</string>
</resources>
